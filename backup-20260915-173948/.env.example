# ── Supabase ─────────────────────────────────────────────────────────
# Without these, ordering does not work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS — every write and every read of customer data
# goes through it. Never expose it to the browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Kitchen screen (/kitchen) ────────────────────────────────────────
# Both are REQUIRED. If either is missing, /kitchen is locked rather than open.
# STAFF_PIN: what the kitchen types on the iPad. 4-12 digits.
STAFF_PIN=
# STAFF_SESSION_SECRET: signs the session cookie. Min 32 chars, random.
#   openssl rand -base64 32
STAFF_SESSION_SECRET=

# ── Retention ────────────────────────────────────────────────────────
# Protects /api/cron/purge, which deletes orders older than 30 days.
# Vercel Cron sends it as a Bearer token; see vercel.json.
#   openssl rand -base64 32
CRON_SECRET=

# ── Kitchen alerts (optional but recommended) ────────────────────────
# Not env vars — set these in the `settings` table, row id = 'main':
#   webhook_url     https:// endpoint hit when an order lands (SMS gateway,
#                   Slack, Make, n8n). The chime only fires if the KDS tab is
#                   open; this reaches a phone when it isn't.
#   webhook_secret  signs the payload as X-Prepnest-Signature: sha256=<hmac>

# ── Backup & nødsystem (Google Sheet) ────────────────────────────────
# The Apps Script web-app URL from fallback/OPSAETNING.md. Every order is
# copied here as it is created — so the Sheet is never cold when you need it,
# and it doubles as the backup the Supabase free tier does not provide.
# If the database write fails, this is what catches the order.
SHEET_WEBHOOK_URL=
# Must match PREPNEST_SECRET in the Apps Script project properties.
SHEET_WEBHOOK_SECRET=

# ── SMS-gateway (Android-telefon) ────────────────────────────────────
# Bearer-token telefonen bruger mod /api/sms/pending og /api/sms/report.
# Mindst 32 tegn. Se docs/SMS-GATEWAY.md.
SMS_GATEWAY_SECRET=
# Hvor længe sms_enabled caches (ms). Standard 60000 — så et skift i
# settings-tabellen slår igennem inden for et minut. Sæt kun lavere ved test.
SMS_STATE_CACHE_MS=

# Dit eget mobilnummer — hertil sendes fejlbeskeder, fx +4512345678.
OWNER_PHONE=

# Sidste udvej for fejlbeskeder: rammer denne URL, hvis selv databasen er nede,
# så en fejl aldrig forsvinder helt lydløst. Valgfri.
SETTINGS_WEBHOOK_FALLBACK_URL=

# ── Site ─────────────────────────────────────────────────────────────
# Used for canonical URLs and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.jisushi.dk
