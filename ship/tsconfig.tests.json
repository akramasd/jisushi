{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "target": "ES2022",
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "lib/**/*.ts",
    "app/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
